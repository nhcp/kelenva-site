---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'Nazmul — DevOps & Cloud Engineer. Docker, Kubernetes, Terraform, AWS.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
</head>
<body>
  <nav class="pathnav">
    <div class="wrap pathnav-inner">
      <span class="path-root">~/kelenva</span>
      <div class="pathnav-links">
        <a href="/">home</a>
        <a href="/projects">projects</a>
        <a href="/platform">platform</a>
        <a href="/services">services</a>
        <a href="/about">about</a>
      </div>
    </div>
  </nav>

  <main class="wrap">
    <slot />
  </main>

  <footer class="statusbar">
    <span class="status-item"><span class="status-dot green"></span>kelenva.com</span>
    <span class="status-item">deployed via GitHub Actions</span>
    <span class="status-item">Hetzner · Nuremberg</span>
    <span class="status-item statusbar-branch">⎇ main</span>
  </footer>
</body>
</html>

<style>
  .pathnav {
    border-bottom: 1px solid var(--border);
    background: var(--bg-base);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .pathnav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 52px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .path-root {
    color: var(--accent-teal);
    font-weight: 500;
  }
  .pathnav-links {
    display: flex;
    gap: 1.25rem;
  }
  .pathnav-links a {
    text-decoration: none;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }
  .pathnav-links a:hover {
    color: var(--text-primary);
  }
  main {
    min-height: calc(100vh - 52px - 2.5rem);
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .statusbar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2.5rem;
    background: var(--accent-teal);
    color: #06201C;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    overflow-x: auto;
    white-space: nowrap;
  }
  .status-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }
  .status-dot.green { background: #0B7A5E; }
  .statusbar-branch {
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .pathnav-inner {
      gap: 1rem;
      height: 48px;
    }
    .pathnav-links {
      gap: 0.85rem;
    }
    .statusbar {
      gap: 1rem;
      padding: 0 0.85rem;
      font-size: 0.68rem;
    }
    .statusbar-branch {
      display: none;
    }
  }
</style>
